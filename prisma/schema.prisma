// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id              String   @id @default(uuid()) @db.VarChar(36)
  email           String   @unique @db.VarChar(255)
  name            String?  @db.VarChar(255)
  role            Role     @default(USER)
  tickets         Ticket[] @relation("UserTickets")       // tickets creados por el usuario
  assignedTickets Ticket[] @relation("AgentTickets")      // tickets asignados como agente
  messages        Message[]
}

enum Role {
  USER
  AGENT
  ADMIN
}

model Ticket {
  id          String       @id @default(uuid()) @db.VarChar(36)
  title       String       @db.VarChar(255)
  description String       @db.Text
  status      TicketStatus @default(OPEN)
  priority    Priority     @default(MEDIUM)
  category    Category?    @relation(fields: [categoryId], references: [id])
  categoryId  String?      @db.VarChar(36)
  user        User         @relation("UserTickets", fields: [userId], references: [id])
  userId      String       @db.VarChar(36)
  agent       User?        @relation("AgentTickets", fields: [agentId], references: [id])
  agentId     String?      @db.VarChar(36)
  messages    Message[]
  createdAt   DateTime     @default(now()) @db.Timestamp(6)
  updatedAt   DateTime     @updatedAt @db.Timestamp(6)
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Message {
  id        String   @id @default(uuid()) @db.VarChar(36)
  content   String   @db.Text
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  ticketId  String   @db.VarChar(36)
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String   @db.VarChar(36)
  createdAt DateTime @default(now()) @db.Timestamp(6)
}

model Category {
  id      String   @id @default(uuid()) @db.VarChar(36)
  name    String   @db.VarChar(255)
  tickets Ticket[]
}
